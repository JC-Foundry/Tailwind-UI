{
  "name": "jc-tailwind-ui",
  "version": "0.1.0",
  "description": "A reusable Tailwind v4 styling bundle with JC Foundry design tokens, a semantic colour system, and thin Bootstrap-flavoured component classes.",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/styling.css",
    "./styling.css": "./src/styling.css",
    "./dist/jc-tailwind-ui.css": "./dist/jc-tailwind-ui.css"
  },
  "scripts": {
    "build": "tailwindcss -i ./src/styling.css -o ./dist/jc-tailwind-ui.css",
    "build:min": "tailwindcss -i ./src/styling.css -o ./dist/jc-tailwind-ui.min.css --minify",
    "dist": "npm run build && npm run build:min",
    "watch": "tailwindcss -i ./src/styling.css -o ./dist/jc-tailwind-ui.css --watch",
    "example:html": "tailwindcss -i ./examples/static-html/input.css -o ./examples/static-html/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
