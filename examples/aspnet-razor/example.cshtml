@* Example Razor markup using JC Tailwind UI tone + treatment classes.
   Works with ASP.NET tag/validation helpers out of the box. *@
@model LoginViewModel

<div class="container-page section">
  <div class="card" style="max-width:28rem; margin-inline:auto;">
    <h2>Sign in</h2>

    <form asp-action="Login" method="post" style="display:flex; flex-direction:column; gap:1rem; margin-top:1rem;">
      <div asp-validation-summary="ModelOnly" class="alert alert-accent tone-danger"></div>

      <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
      </div>

      <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password" class="field-validation-error"></span>
      </div>

      <label style="display:flex; align-items:center; gap:.5rem; margin:0;">
        <span class="switch" data-switch-name="RememberMe"></span> Remember me
      </label>

      <div style="display:flex; justify-content:flex-end; gap:.5rem;">
        <button type="button" class="btn btn-soft">Cancel</button>
        <button type="submit" class="btn btn-solid">Sign in</button>
      </div>
    </form>
  </div>
</div>
